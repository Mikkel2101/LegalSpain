---
import type { Translations } from '../i18n/index';
import { img } from '../utils/asset';

interface Props {
  tr: Translations;
}

const { tr } = Astro.props;
const { booking } = tr;
---

<section class="relative bg-navy-dark py-24 lg:py-32 overflow-hidden">
  <!-- Background image with strong overlay -->
  <div class="absolute inset-0">
    <img
      src={img('/assets/images/paradise-between-2-seas.jpg')}
      alt="La Manga – paradis mellom to hav"
      class="w-full h-full object-cover object-center"
    />
    <div class="absolute inset-0 bg-navy/80"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8">
    <div class="max-w-2xl">
      <!-- Eyebrow -->
      <p class="text-gold text-xs font-semibold tracking-[0.3em] uppercase mb-6">
        {booking.eyebrow}
      </p>

      <!-- Heading -->
      <h2 class="font-serif text-4xl lg:text-5xl text-white leading-tight mb-6">
        {booking.heading}
      </h2>

      <!-- Body -->
      <p class="text-sand/65 text-lg leading-relaxed mb-10 font-light">
        {booking.text}
      </p>

      <!-- CTA -->
      <a
        href={booking.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 bg-gold hover:bg-gold-light text-white px-8 py-4 font-sans font-semibold text-sm tracking-wide transition-colors duration-200"
      >
        {booking.cta}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </div>
</section>
