---
import type { Lang } from '../i18n/index';
import { t, langLabels, langPaths } from '../i18n/index';
import { img } from '../utils/asset';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = t(lang);
const langs = Object.keys(langLabels) as Lang[];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-navy/95 backdrop-blur-sm border-b border-white/5">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">

      <!-- Logo -->
      <a href={langPaths[lang]} class="flex items-center gap-3 shrink-0">
        <img
          src={img('/assets/images/legal-logo.png')}
          alt="Legal Spania"
          class="h-10 w-auto object-contain"
        />
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-8">
        {
          [
            { key: 'properties', href: '#eiendommer' },
            { key: 'services', href: '#tjenester' },
            { key: 'about', href: '#om-oss' },
            { key: 'contact', href: '#kontakt' },
          ].map((item) => (
            <a
              href={item.href}
              class="text-sand/70 hover:text-sand text-sm font-medium tracking-wide transition-colors duration-200"
            >
              {tr.nav[item.key as keyof typeof tr.nav]}
            </a>
          ))
        }
      </nav>

      <!-- Right side: phone + language switcher -->
      <div class="hidden lg:flex items-center gap-6">
        <a
          href={`tel:${tr.contact.phone.replace(/\s/g, '')}`}
          class="text-sand/70 hover:text-gold text-sm font-medium tracking-wide transition-colors duration-200"
        >
          {tr.contact.phone}
        </a>
        <div class="flex items-center gap-1 border border-white/10 rounded px-1 py-1">
          {
            langs.map((l) => (
              <a
                href={langPaths[l]}
                class={`px-2 py-1 text-xs font-semibold tracking-wider rounded transition-colors duration-150 ${
                  l === lang
                    ? 'bg-gold text-white'
                    : 'text-sand/50 hover:text-sand'
                }`}
              >
                {langLabels[l]}
              </a>
            ))
          }
        </div>
      </div>

      <!-- Mobile menu button -->
      <button
        id="menu-btn"
        class="lg:hidden flex flex-col gap-1.5 p-2 text-sand"
        aria-label="Meny"
      >
        <span class="block w-6 h-0.5 bg-current transition-transform duration-200" id="bar1"></span>
        <span class="block w-6 h-0.5 bg-current transition-opacity duration-200" id="bar2"></span>
        <span class="block w-6 h-0.5 bg-current transition-transform duration-200" id="bar3"></span>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="lg:hidden hidden bg-navy border-t border-white/10">
    <nav class="max-w-7xl mx-auto px-6 py-6 flex flex-col gap-4">
      {
        [
          { key: 'properties', href: '#eiendommer' },
          { key: 'services', href: '#tjenester' },
          { key: 'about', href: '#om-oss' },
          { key: 'contact', href: '#kontakt' },
        ].map((item) => (
          <a
            href={item.href}
            class="text-sand/80 hover:text-sand text-base font-medium py-2 border-b border-white/5 transition-colors"
            onclick="document.getElementById('mobile-menu').classList.add('hidden')"
          >
            {tr.nav[item.key as keyof typeof tr.nav]}
          </a>
        ))
      }
      <a
        href={`tel:${tr.contact.phone.replace(/\s/g, '')}`}
        class="text-gold font-semibold text-base pt-2"
      >
        {tr.contact.phone}
      </a>
      <div class="flex gap-2 pt-2">
        {
          langs.map((l) => (
            <a
              href={langPaths[l]}
              class={`px-3 py-1.5 text-xs font-bold tracking-wider rounded border ${
                l === lang
                  ? 'bg-gold border-gold text-white'
                  : 'border-white/20 text-sand/60 hover:text-sand'
              }`}
            >
              {langLabels[l]}
            </a>
          ))
        }
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  const bar1 = document.getElementById('bar1');
  const bar2 = document.getElementById('bar2');
  const bar3 = document.getElementById('bar3');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    if (bar1 && bar2 && bar3) {
      bar1.style.transform = isOpen ? '' : 'translateY(8px) rotate(45deg)';
      bar2.style.opacity = isOpen ? '1' : '0';
      bar3.style.transform = isOpen ? '' : 'translateY(-8px) rotate(-45deg)';
    }
  });
</script>
